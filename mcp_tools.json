      "description": "List sales orders with status (draft/open/invoiced/void/closed), customer, total, shipment and invoiced/paid/shipped flags. Filter by status, customer name or id, order number, free text or a date range (YYYY-MM-DD), sort and paginate. Use zoho_inventory_get_sales_order for line items of one order.",
      "inputSchema": {
        "properties": {
          "filter_by": {
            "anyOf": [
              {
                "enum": [
                  "Status.All",
                  "Status.Draft",
                  "Status.Open",
                  "Status.Invoiced",
                  "Status.PartiallyInvoiced",
                  "Status.Void",
                  "Status.Closed"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Predefined status filter, e.g. Status.Open.",
            "title": "Filter By"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Exact Zoho status value, e.g. 'open', 'draft', 'invoiced', 'void'.",
            "title": "Status"
          },
          "customer_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Customer Name"
          },
          "customer_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Zoho contact id of the customer.",
            "title": "Customer Id"
          },
          "salesorder_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Exact order number, e.g. 'SO-00012'.",
            "title": "Salesorder Number"
          },
          "search_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Free text across order number, reference and customer.",
            "title": "Search Text"
          },
          "date_start": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
