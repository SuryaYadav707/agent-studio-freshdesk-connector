              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Orders dated on/before this day (YYYY-MM-DD).",
            "title": "Date End"
          },
          "sort_column": {
            "default": "date",
            "enum": [
              "customer_name",
              "salesorder_number",
              "shipment_date",
              "total",
              "date",
              "created_time",
              "last_modified_time"
            ],
            "title": "Sort Column",
            "type": "string"
          },
          "sort_order": {
            "default": "D",
            "enum": [
              "A",
              "D"
            ],
            "title": "Sort Order",
            "type": "string"
          },
          "page": {
            "default": 1,
            "title": "Page",
            "type": "integer"
          },
          "per_page": {
            "default": 50,
            "title": "Per Page",
            "type": "integer"
          }
        },
        "title": "zoho_inventory_list_sales_ordersArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "meta": {
        "documentation_url": "https://www.zoho.com/inventory/api/v1/salesorders/#list-all-sales-orders",
        "integration": "zoho_inventory",
        "task": "list_sales_orders"
      }
    },
    {
      "name": "zoho_inventory_get_sales_order",
      "title": "Zoho Inventory: Get Zoho Inventory sales order",
      "description": "Fetch one sales order by salesorder_id with line items (item, SKU, quantity ordered / invoiced / shipped, rate), totals, addresses and notes. Use after listing orders to answer questions about a specific order.",
      "inputSchema": {
        "properties": {
          "salesorder_id": {
            "description": "Zoho salesorder_id (numeric string). Not the SO-00012 number; list orders to map it.",
            "title": "Salesorder Id",
            "type": "string"
          }
        },
        "required": [
          "salesorder_id"
        ],
        "title": "zoho_inventory_get_sales_orderArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "meta": {
        "documentation_url": "https://www.zoho.com/inventory/api/v1/salesorders/#retrieve-a-sales-order",
        "integration": "zoho_inventory",
        "task": "get_sales_order"
      }
    }
  ]
}
