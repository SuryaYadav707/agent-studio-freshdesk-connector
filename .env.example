# Copy to .env and fill in. Never commit .env.

# Which environment_specific_fields block of integrations_config.json to use: local | dev | prod
CONNECTOR_ENV=local

# Which integrations the MCP server / UI expose (comma separated)
CONNECTOR_INTEGRATIONS=freshdesk,zoho_inventory

# Where OAuth tokens / validated credentials are stored (JSON per integration, chmod 600)
CREDENTIALS_DIR=./tokens

# Demo UI base URL (must match the redirect URI registered in Zoho API Console)
UI_BASE_URL=http://localhost:8765
# Optional: fixed secret for the UI session cookie (flash messages). Random per process when empty.
UI_SECRET=

# ---- Freshdesk (API key / form auth) ----
# Optional: pre-fill so `connector auth freshdesk` can validate without the UI
FRESHDESK_DOMAIN=your-helpdesk-subdomain
FRESHDESK_API_KEY=replace-me

# ---- Zoho Inventory (OAuth 2.0) ----
ZOHO_CLIENT_ID=replace-me
ZOHO_CLIENT_SECRET=replace-me
# Data center of the Zoho account: com | in | eu | com.au | jp | ca
ZOHO_DC=in
# Optional: force an organization id; auto-detected after consent when the account has one org
ZOHO_ORGANIZATION_ID=

# ---- Agent chat (demo UI) ----
ANTHROPIC_API_KEY=replace-me
# claude-opus-5-5 (default, $4/$20 per MTok) or claude-sonnet-5-5 ($2/$10) for a cheaper demo
ANTHROPIC_MODEL=claude-opus-5-5
